APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_DOMAIN=localhost

# APP_URL=http://example.com
# SESSION_DOMAIN=.example.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
TELESCOPE_ENABLED=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=photo-rent
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120


# FILESYSTEM_DRIVER=wasabi
# WASABI_KEY=YOUR_WASABI_KEY
# WASABI_SECRET=YOUR_WASABI_SECRET
# WASABI_REGION=us-east-1
# WASABI_BUCKET=your-wasabi-bucket
# WASABI_ENDPOINT=https://s3.us-east-1.wasabisys.com
# WASABI_SSL_VERIFY=true






MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Self-hosted OpenCV face analysis. Keep disabled until the migrations have
# been reviewed/run and the local service has its two model files mounted.
FACE_RECOGNITION_ENABLED=false
FACE_RECOGNITION_PROVIDER=opencv
FACE_RECOGNITION_QUEUE=faces
FACE_RECOGNITION_URL=http://127.0.0.1:8090
FACE_RECOGNITION_API_KEY=
FACE_RECOGNITION_TIMEOUT=60
FACE_RECOGNITION_CONNECT_TIMEOUT=5
FACE_RECOGNITION_MODEL_VERSION=opencv-yunet-2023mar+sface-2021dec
FACE_RECOGNITION_ANALYSIS_MAX_DIMENSION=2000
FACE_RECOGNITION_ANALYSIS_JPEG_QUALITY=82
FACE_RECOGNITION_CROP_SIZE=256
FACE_RECOGNITION_CROP_PADDING=0.18
FACE_RECOGNITION_STORAGE_DISK=wasabi
